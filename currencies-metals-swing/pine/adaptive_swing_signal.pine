//@version=6
// =====================================================================
//  Adaptive Swing Signal — Pine v6  (non-repainting)
//  Companion to the AdaptiveSwingTrader MQL5 EA.
//
//  Trend regime : SuperTrend(ATR) + ADX strength + EMA filter + ATR
//                 volatility-percentile gate.
//  Entries      : pullback-to-EMA continuation OR Donchian breakout,
//                 in the trend direction, with a momentum candle.
//  COT bias     : MANUAL input (Pine can't call your COT API). Set it
//                 from https://cotapi.onrender.com/api/bias each week.
//
//  Non-repainting by construction: a signal is only committed on
//  barstate.isconfirmed, so on the live bar nothing is drawn until the
//  bar closes — historical signals never move. No security() lookahead.
// =====================================================================
indicator("Adaptive Swing Signal", overlay = true, max_labels_count = 500)

// ---------------- inputs ----------------
grpT = "Trend Regime"
stPeriod  = input.int(10,  "SuperTrend ATR period", group = grpT, minval = 1)
stMult    = input.float(3.0,"SuperTrend multiplier", group = grpT, step = 0.1)
emaTrend  = input.int(50,  "EMA trend filter",       group = grpT, minval = 1)
adxLen    = input.int(14,  "ADX length",             group = grpT, minval = 1)
adxMin    = input.float(18,"ADX minimum",            group = grpT)

grpV = "Volatility Gate"
atrLen     = input.int(14, "ATR period",             group = grpV, minval = 1)
atrPctWin  = input.int(100,"ATR percentile window",  group = grpV, minval = 10)
atrPctMin  = input.float(5, "Skip below ATR %ile",   group = grpV)
atrPctMax  = input.float(97,"Skip above ATR %ile",   group = grpV)

grpE = "Entries"
mode       = input.string("Either", "Entry mode", options = ["Pullback","Breakout","Either"], group = grpE)
emaPull    = input.int(20, "Pullback EMA",           group = grpE, minval = 1)
pullLook   = input.int(6,  "Pullback lookback bars", group = grpE, minval = 1)
donLen     = input.int(20, "Donchian breakout length", group = grpE, minval = 1)

grpC = "COT bias (manual)"
cotBias    = input.string("Off", "COT bias for this pair", options = ["Off","Buy","Sell"], group = grpC)
cotFilter  = input.bool(false, "Hide signals that disagree with COT", group = grpC)

// ---------------- indicators ----------------
atr  = ta.atr(atrLen)
emaT = ta.ema(close, emaTrend)
emaP = ta.ema(close, emaPull)
[diP, diM, adxv] = ta.dmi(adxLen, adxLen)
[stLine, stDir]  = ta.supertrend(stMult, stPeriod)   // stDir: -1 up, +1 down
atrPct = ta.percentrank(atr, atrPctWin)

volOK   = atrPct >= atrPctMin and atrPct <= atrPctMax
strong  = adxv >= adxMin
trendUp = stDir < 0 and close > emaT and strong and volOK
trendDn = stDir > 0 and close < emaT and strong and volOK

// ---------------- entry logic ----------------
dippedL = ta.lowest(low,  pullLook) <= emaP
dippedS = ta.highest(high, pullLook) >= emaP
bull    = close > open and close > close[1]
bear    = close < open and close < close[1]
donHi   = ta.highest(high, donLen)[1]
donLo   = ta.lowest(low,  donLen)[1]

longPull  = trendUp and dippedL and bull and close >= emaP
shortPull = trendDn and dippedS and bear and close <= emaP
longBrk   = trendUp and close > donHi and bull
shortBrk  = trendDn and close < donLo and bear

longRaw  = mode == "Pullback" ? longPull  : mode == "Breakout" ? longBrk  : (longPull or longBrk)
shortRaw = mode == "Pullback" ? shortPull : mode == "Breakout" ? shortBrk : (shortPull or shortBrk)

// COT manual filter
longRaw  := cotFilter and cotBias == "Sell" ? false : longRaw
shortRaw := cotFilter and cotBias == "Buy"  ? false : shortRaw

// NON-REPAINT: only commit on a closed bar
longSig  = longRaw  and barstate.isconfirmed
shortSig = shortRaw and barstate.isconfirmed

// ---------------- plots ----------------
plot(stLine, "SwingTrend", color = stDir < 0 ? color.new(color.lime, 0) : color.new(color.red, 0), linewidth = 2)
plotshape(longSig,  title = "Buy",  style = shape.triangleup,   location = location.belowbar, color = color.aqua,    size = size.small, text = "BUY")
plotshape(shortSig, title = "Sell", style = shape.triangledown, location = location.abovebar, color = color.fuchsia, size = size.small, text = "SELL")

alertcondition(longSig,  "Adaptive Swing BUY",  "Adaptive Swing BUY on {{ticker}} {{interval}}")
alertcondition(shortSig, "Adaptive Swing SELL", "Adaptive Swing SELL on {{ticker}} {{interval}}")

// ---------------- dashboard ----------------
var table dash = table.new(position.top_right, 2, 5, border_width = 1)
if barstate.islast
    regimeTxt = trendUp ? "UP" : trendDn ? "DOWN" : "FLAT"
    regimeCol = trendUp ? color.new(color.green, 0) : trendDn ? color.new(color.red, 0) : color.new(color.gray, 0)
    table.cell(dash, 0, 0, "ADAPTIVE SWING", text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dash, 1, 0, syminfo.ticker,   text_color = color.white, bgcolor = color.new(color.blue, 0))
    table.cell(dash, 0, 1, "Regime",  text_color = color.silver)
    table.cell(dash, 1, 1, regimeTxt, text_color = color.white, bgcolor = regimeCol)
    table.cell(dash, 0, 2, "ADX",     text_color = color.silver)
    table.cell(dash, 1, 2, str.tostring(adxv, "#.0"), text_color = color.white)
    table.cell(dash, 0, 3, "ATR %ile",text_color = color.silver)
    table.cell(dash, 1, 3, str.tostring(atrPct, "#.0"), text_color = color.white)
    table.cell(dash, 0, 4, "COT",     text_color = color.silver)
    table.cell(dash, 1, 4, cotBias,   text_color = color.white)
